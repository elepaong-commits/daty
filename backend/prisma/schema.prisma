datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

enum PlaceCategory {
  FOOD
  CAFE
  DESSERT
  EXHIBIT
  TOUR
  ACTIVITY
  HOTEL
}

enum PlaceStatus {
  WISH
  VISITED
}

enum RecordType {
  PLAN
  RECORD
}

enum MediaType {
  PHOTO
  VIDEO
}

model Couple {
  id              Int          @id @default(autoincrement())
  coupleCode      String       @unique @map("couple_code")
  anniversaryDate DateTime     @map("anniversary_date") @db.Date
  createdAt       DateTime     @default(now()) @map("created_at")
  users           User[]
  records         DateRecord[]
  places          Place[]
  albums          Album[]
  placeNotes      PlaceNote[]

  @@map("couples")
}

model User {
  id                Int                 @id @default(autoincrement())
  coupleId          Int?                @map("couple_id")
  email             String              @unique
  passwordHash      String              @map("password_hash")
  nickname          String
  profileImageUrl   String?             @map("profile_image_url")
  // 이보다 먼저 발급된 로그인 세션은 무효 (비밀번호를 바꾸면 다른 기기에서 로그아웃된다)
  passwordChangedAt DateTime?           @map("password_changed_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  couple            Couple?             @relation(fields: [coupleId], references: [id])
  writtenRecords    DateRecord[]
  placeNotes        PlaceNote[]
  resetCodes        PasswordResetCode[] @relation("resetCodeUser")
  issuedResetCodes  PasswordResetCode[] @relation("resetCodeIssuer")

  @@map("users")
}

model Place {
  id            Int           @id @default(autoincrement())
  coupleId      Int           @map("couple_id")
  name          String
  category      PlaceCategory
  status        PlaceStatus   @default(WISH)
  address       String?
  latitude      Decimal?      @db.Decimal(9, 6)
  longitude     Decimal?      @db.Decimal(9, 6)
  googleMapsUrl String?       @map("google_maps_url")
  googlePlaceId String?       @map("google_place_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  couple        Couple        @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  records       DateRecord[]
  notes         PlaceNote[]

  @@unique([coupleId, googlePlaceId])
  @@index([coupleId, status, category])
  @@map("places")
}

// 장소 메모. 본문에 {{EAT}} 같은 태그 토큰이 들어가고, 화면에서 보는 사람의 언어로 표시된다
// 비밀번호 재설정 코드. 짝꿍이 앱에서 발급해 전달하고, 잊어버린 사람이 로그인 화면에서 입력한다.
// 원문은 저장하지 않고 SHA-256만 둔다. 10분 유효, 한 번만, 5번 틀리면 못 쓴다
model PasswordResetCode {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  issuedById Int?     @map("issued_by_id")
  codeHash   String   @map("code_hash")
  attempts   Int      @default(0)
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation("resetCodeUser", fields: [userId], references: [id], onDelete: Cascade)
  issuedBy   User?    @relation("resetCodeIssuer", fields: [issuedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("password_reset_codes")
}

model PlaceNote {
  id        Int      @id @default(autoincrement())
  coupleId  Int      @map("couple_id")
  placeId   Int      @map("place_id")
  writerId  Int?     @map("writer_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  couple    Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  writer    User?    @relation(fields: [writerId], references: [id], onDelete: SetNull)

  @@index([placeId, createdAt])
  @@map("place_notes")
}

model DateRecord {
  id          Int           @id @default(autoincrement())
  coupleId    Int           @map("couple_id")
  placeId     Int?          @map("place_id")
  writerId    Int?          @map("writer_id")
  albumId     Int?          @map("album_id")
  type        RecordType    @default(PLAN)
  title       String
  memo        String?
  category    PlaceCategory
  rating      Int?          @db.SmallInt // 1~5, CHECK는 마이그레이션 SQL로
  scheduledAt DateTime      @map("scheduled_at") @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  couple      Couple        @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  place       Place?        @relation(fields: [placeId], references: [id], onDelete: SetNull)
  writer      User?         @relation(fields: [writerId], references: [id], onDelete: SetNull)
  album       Album?        @relation(fields: [albumId], references: [id], onDelete: SetNull)

  @@index([coupleId, scheduledAt])
  @@map("date_records")
}

model Album {
  id            Int          @id @default(autoincrement())
  coupleId      Int          @map("couple_id")
  title         String
  albumDate     DateTime     @map("album_date") @db.Date // first day
  albumEndDate  DateTime?    @map("album_end_date") @db.Date // last day of a trip; null when the album is one day
  // A month of everyday photos (home, usual spots): covers the whole month without holding its days for date albums.
  monthly       Boolean      @default(false)
  highlightNote String?      @map("highlight_note") // 꼭 봐야 할 포인트
  coverPhotoId  Int?         @map("cover_photo_id")
  createdAt     DateTime     @default(now()) @map("created_at")
  couple        Couple       @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  photos        Photo[]
  records       DateRecord[]

  @@index([coupleId, albumDate])
  @@map("albums")
}

model Photo {
  id           Int       @id @default(autoincrement())
  albumId      Int       @map("album_id")
  imageUrl     String?   @map("image_url") // 외부 URL로 들어온 예전 사진
  storageKey   String?   @unique @map("storage_key") // R2 객체 키. 응답에서는 서명 URL로 바뀐다
  thumbnailKey String?   @unique @map("thumbnail_key") // 목록·카드용 작은 사본의 R2 키(동영상은 첫 장면). 없으면 원본을 쓴다
  displayOrder Int       @default(1) @map("display_order")
  takenAt      DateTime? @map("taken_at") // 사진의 EXIF(동영상은 mvhd) 촬영 시각 → 날짜별 자동 묶기
  mediaType    MediaType @default(PHOTO) @map("media_type")
  durationSec  Float?    @map("duration_sec") // 동영상 길이. 브라우저가 못 읽은 동영상은 null
  createdAt    DateTime  @default(now()) @map("created_at")
  album        Album     @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([albumId, displayOrder])
  @@map("photos")
}
