# Local dev DB (npm run db:up). Production uses its own DATABASE_URL on the server.
DATABASE_URL="postgresql://daty:daty@localhost:5433/daty_dev?schema=public"

# 127.0.0.1 keeps the API behind a reverse proxy on the server
HOST=127.0.0.1
PORT=4000

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Temporary stand-in for login (development only): every API request acts as this couple.
# Created by `npx prisma db seed`.
DEV_COUPLE_CODE=DEV-COUPLE
