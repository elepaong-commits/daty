# Local dev DB (npm run db:up). Production uses its own DATABASE_URL on the server.
DATABASE_URL="postgresql://daty:daty@localhost:5433/daty_dev?schema=public"

# 127.0.0.1 keeps the API behind a reverse proxy on the server
HOST=127.0.0.1
PORT=4000

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Signs login cookies. Generate a fresh one per environment: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Number of reverse proxies in front of the API (set to 1 behind Nginx in production)
TRUST_PROXY=0
# 가입은 기본으로 닫혀 있다. 새 계정이 필요할 때만 true로 열고 재시작한다
SIGNUP_ENABLED=true

# Cloudflare R2 bucket for album photos (private; the API hands out signed URLs).
# R2 > Manage API tokens > Object Read & Write, scoped to this bucket. Leave empty to disable uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Password reset by email (https://resend.com, free plan). Leave empty to keep only the partner-issued code.
RESEND_API_KEY=
# e.g. "daty <no-reply@your-domain>" — the domain must be verified in Resend
MAIL_FROM=
# Frontend address used for links in emails, e.g. https://ourdaty.com
APP_URL=

# Web push notifications. Generate a pair with: npx web-push generate-vapid-keys. Leave empty to disable.
# DB 백업 전용 R2 버킷과 그 버킷에만 쓸 수 있는 토큰(비우면 사진 버킷에 저장). docs/operations.md
BACKUP_R2_BUCKET=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
# 서버 오류·앱 오류·백업 실패 알림을 받을 메일(Resend 설정 필요)
ADMIN_EMAIL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact the push services can reach if something goes wrong, e.g. mailto:you@example.com
VAPID_SUBJECT=
