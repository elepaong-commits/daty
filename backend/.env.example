# Local dev: open an SSH tunnel first (ssh -L 5432:localhost:5432 oracle-server)
DATABASE_URL="postgresql://date_user:CHANGE_ME@localhost:5432/date_app?schema=public"

# 127.0.0.1 keeps the API behind a reverse proxy on the server
HOST=127.0.0.1
PORT=4000

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
