# Google Maps (https://console.cloud.google.com) — restrict the key to your site's referrers
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
# Optional map style for the pixel design (cream ground, pale water). Falls back to VITE_GOOGLE_MAPS_MAP_ID.
VITE_GOOGLE_MAPS_MAP_ID_RETRO=
# Optional map style for the scrapbook design (paper ground, pencil-brown roads). Falls back the same way.
VITE_GOOGLE_MAPS_MAP_ID_SCRAP=

# Backend origin for production builds. Leave empty in dev (Vite proxies /api to :4000).
VITE_API_URL=
